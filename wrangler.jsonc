{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "botghost-sms-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "GATEWAY", "class_name": "GatewayQueue" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GatewayQueue"] }
  ]
}
